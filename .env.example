# Copy this file to `.env` in the repository root and fill in your own values.
# `.env` is ignored by Git. Never paste keys into prompts, source files or issues.

# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=
SHOTSTACK_API_KEY=

# "stage" = sandbox (watermarked output). "production" = real renders that use credits.
# The Shotstack key must belong to the same environment you select here.
SHOTSTACK_ENV=stage

# --- Optional OpenAI model overrides ---------------------------------------
# Model names change. Defaults follow OpenAI's current docs, but confirm that
# your account has access, and override here instead of editing code.
# OPENAI_TEXT_MODEL=gpt-6.2-astra
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_SIZE=1024x1536
# OPENAI_IMAGE_QUALITY=medium

# Narration. NOTE: OpenAI's docs list gpt-4o-mini-tts, tts-1 and tts-1-hd as
# shutting down on 2027-01-06. See docs/pipeline.md before relying on them.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin

# --- Optional caption font (must be a .ttf URL plus its family id) ----------
# CAPTION_FONT_URL=
# CAPTION_FONT_FAMILY=
